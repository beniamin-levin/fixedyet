# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=            # Token Factory API key (tokenfactory.nebius.com > API keys)
NEBIUS_PROJECT_ID=         # Token Factory project id, needed for Sandboxes
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
FIXEDYET_MODEL=nvidia/nemotron-3-super-120b-a12b
FIXEDYET_SMALL_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
CONTREE_TOKEN=             # Sandboxes token, if different from NEBIUS_API_KEY
CONTREE_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes/
TAVILY_API_KEY=            # app.tavily.com
GITHUB_TOKEN=              # optional: read-only lifts the rate limit. `backport --open-pr`, `fix --open-pr` and the web demo's maintainer buttons need a classic PAT with only public_repo (an expiry you choose), used for draft PRs in your fork or, after a typed confirmation, on the upstream project
FIXEDYET_SANDBOX=docker # docker (a local daemon) | nebius (Sandboxes beta: pip install ".[nebius]", NEBIUS_PROJECT_ID)
FIXEDYET_RUN_BUDGET_USD=0.60
FIXEDYET_FIX_BUDGET_USD=0.25  # fix mode: model cost cap of one fix, all attempts included
FIXEDYET_TOTAL_BUDGET_USD=20
FIXEDYET_MAX_TURNS=20
FIXEDYET_DEMO_DAILY_LIMIT=5
FIXEDYET_RUNS_DIR=runs
FIXEDYET_LEDGER_PATH=        # lifetime spend ledger; empty = ~/.local/state/fixedyet/spend-ledger.json (or $XDG_STATE_HOME/fixedyet/...), whatever FIXEDYET_RUNS_DIR is
FIXEDYET_KEEP_CHECKPOINTS=6  # docker sandbox: newest fixedyet-ckpt images kept after each run (1.5 GB each)
FIXEDYET_ROOT_PATH=          # URL prefix for `fixedyet serve` behind a proxy that strips it, e.g. /fixedyet
FIXEDYET_ADMIN_TOKEN=        # web demo maintainer mode (reports page: verify a backport, attempt a fix of an open bug, open a draft PR, hide a report); random, 32+ bytes: `openssl rand -hex 32`. Empty = off
FIXEDYET_JUDGE_CODES=        # web demo: comma-separated codes for hackathon judges (12+ characters each: `openssl rand -hex 8`); their runs use FIXEDYET_JUDGE_DAILY_LIMIT, not the public limit. Empty = off
FIXEDYET_JUDGE_DAILY_LIMIT=20  # live runs per UTC day for all judge codes together
FIXEDYET_JUDGE_RESERVE_USD=0   # model budget kept for judges: public runs stop when less than this plus one run is left under FIXEDYET_TOTAL_BUDGET_USD
